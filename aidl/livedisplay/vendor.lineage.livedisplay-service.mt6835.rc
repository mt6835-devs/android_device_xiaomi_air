on boot
    chown system system /sys/class/mi_display/disp-DSI-0/disp_param
    chmod 0666 /sys/class/mi_display/disp-DSI-0/disp_param
    chown system system /sys/class/mi_display/disp-DSI-0/dc_status
    chmod 0666 /sys/class/mi_display/disp-DSI-0/dc_status

service vendor.livedisplay-hal-mt6835 /vendor/bin/hw/vendor.lineage.livedisplay-service.mt6835
    class hal
    user system
    group system
