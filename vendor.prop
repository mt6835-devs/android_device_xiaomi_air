# Audio
aaudio.mmap_policy=0
aaudio.mmap_exclusive_policy=0
vendor.audio.powerhal.power.dl=true
ro.vendor.audio.vocal.support=true
ro.vendor.audio.us.proximity=true
ro.vendor.audio.us.proximity_waitfornegative_feature=true
ro.audio.monitorRotation=true
vendor.audio.spkcal.copy.inhal=true
vendor.audiohal.telephonytx.type=2
ro.config.media_vol_default=10
ro.config.media_vol_steps=25
ro.config.vc_call_vol_default=4
ro.config.vc_call_vol_steps=12

# Connectivity
persist.vendor.connsys.chipid=-1
persist.vendor.connsys.coredump.mode=0
persist.vendor.connsys.dynamic.dump=0
persist.vendor.connsys.fm_chipid=connac2x
persist.vendor.connsys.patch.version=-1
persist.vendor.connsysfw.enable=false
ro.vendor.connsys.dedicated.log.port=bt,wifi,ics,btmcu,wifimcu
ro.vendor.connsys.dedicated.log=1
vendor.connsys.driver.ready=no

# Crypto
ro.crypto.volume.filenames_mode=aes-256-cts

# DRM
ro.netflix.bsp_rev=MTK6835-36999-1

# Gatekeeper
ro.hardware.gatekeeper=mitee

# GNSS
ro.vendor.gps.chrdev=gps_drv_stp

